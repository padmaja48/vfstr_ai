# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:4000

# MongoDB Atlas
MONGODB_URI=

# Tests: isolated DB by default (never hits production fluentai unless explicitly overridden)
# MONGODB_TEST_URI=mongodb://localhost:27017/fluentai_test
# ALLOW_PROD_DB_IN_TESTS=1

# Concept generation safety — BOTH vars required for generation-time auto-archive
# CONCEPT_AUTO_ARCHIVE_PRIOR=1
# CONCEPT_AUTO_ARCHIVE_PRIOR_CONFIRM=I_UNDERSTAND_ARCHIVE_RISK

# Auth
JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=fluentai_refresh
COOKIE_SECRET=replace-with-at-least-32-characters

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# AI provider — OpenAI recommended for production text + fallback transcription
AI_PROVIDER=openai
# Set to false in local dev to block all outbound AI requests (non-AI features still work)
AI_CALLS_ENABLED=true
# Structured [AI_CALL] trace logs (defaults on in development)
# AI_CALL_DEBUG=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Fallback STT only (browser SpeechRecognition is primary). Verified slug: gpt-4o-mini-transcribe
WHISPER_MODEL=gpt-4o-mini-transcribe

# Optional Groq fallback: set AI_PROVIDER=groq to use these instead
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-default-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=en
ELEVENLABS_PROFESSIONAL_FEMALE_VOICE_ID=your-female-interviewer-voice-id
ELEVENLABS_PROFESSIONAL_MALE_VOICE_ID=your-male-interviewer-voice-id
ELEVENLABS_NEUTRAL_VOICE_ID=your-neutral-interviewer-voice-id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Optional: Google-quality web search for company interview questions (https://serper.dev)
# If unset, DuckDuckGo HTML search + public page fetch is used.
SERPER_API_KEY=

# Redis / BullMQ (Railway Redis plugin URL)
REDIS_URL=redis://default:password@host:port
BULLMQ_PREFIX=fluentai

# Transactional email
RESEND_API_KEY=re_your-resend-key
SMTP_URL=smtp://user:password@smtp.example.com:587
EMAIL_FROM=FluentAI <noreply@fluentai.example>
# Optional: inbox for `npm run test:welcome-email`
TEST_WELCOME_EMAIL=
# Bulk welcome email batching (defaults: 15 per chunk, 150ms between chunks)
BULK_WELCOME_EMAIL_CHUNK_SIZE=15
BULK_WELCOME_EMAIL_CHUNK_DELAY_MS=150

# Deploy targets
VERCEL_PROJECT_ID=optional-client-project-id
RAILWAY_SERVICE_ID=optional-server-service-id
